generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Registration {
  id              Int      @id @default(autoincrement())
  fullName        String
  dateOfBirth     String
  age             String
  gender          String
  address         String
  city            String
  state           String
  phoneNumber     String
  email           String
  signature       String
  declarationDate String
  parentSignature String
  parentDate      String
  createdAt       DateTime @default(now())
}
